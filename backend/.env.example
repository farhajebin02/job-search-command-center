# --- Vertex AI / Gemini ---------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json
GCP_PROJECT_ID=
# Live models are region-limited. us-central1 has them; asia-south1 does not.
GCP_LOCATION=us-central1
# Realtime speech-to-speech model driving the agent.
GEMINI_LIVE_MODEL=
# Batch model used for resume parsing, job scoring, and interview questions.
GEMINI_BATCH_MODEL=

# --- LiveKit --------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Job source -----------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google Calendar (optional, via workspace-mcp) ------------------------
# Omit these and the agent runs without scheduling tools.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only for local OAuth over http. Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1

# --- Storage --------------------------------------------------------------
DB_PATH=./tracker.db
